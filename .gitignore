# Third-party assets: not ours to publish, and the repo is public.
# official/SOURCES.md says where to download them and lists their sha256.
official/*.zip

# The user's recordings and screenshots from the game: large, and they stay on the Windows PC.
*.mp4
/*.png

# Personal Claude Code settings
.claude/settings.local.json

# Python
__pycache__/
*.pyc
.venv/

# The pictures that come with the Lab's notes on the car, for Claude (tool/notes.py)
.notes/

# Substance Painter templates from the community: not ours to publish
*.spp
*.spp.zip

# Skins by other players, for checking the car map only: not ours to publish
*.rar
/community/
