{
  "permissions": {
    "deny": [
      "Read(//c/Users/fedec/OneDrive/Documents/Trackmania/Skins/Models/CarSport)",
      "Read(//c/Users/fedec/OneDrive/Documents/Trackmania/Skins/Models/CarSport/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"${CLAUDE_PROJECT_DIR}\" pull --ff-only 2>&1 || echo \"The pull from GitHub failed (above): sort it out before other work.\"; \"$HOME/Library/Application Support/TrackmaniaSkinChallenge/venv/bin/python\" \"${CLAUDE_PROJECT_DIR}/tool/doctor.py\" session 2>/dev/null || \"${LOCALAPPDATA}/TrackmaniaSkinChallenge/venv/Scripts/python.exe\" \"${CLAUDE_PROJECT_DIR}/tool/doctor.py\" session 2>/dev/null || python3 \"${CLAUDE_PROJECT_DIR}/tool/doctor.py\" session 2>/dev/null || true",
            "timeout": 120,
            "statusMessage": "Getting the latest from GitHub and checking the tool"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Library/Application Support/TrackmaniaSkinChallenge/venv/bin/python\" \"${CLAUDE_PROJECT_DIR}/tool/notes.py\" --hook 2>/dev/null || \"${LOCALAPPDATA}/TrackmaniaSkinChallenge/venv/Scripts/python.exe\" \"${CLAUDE_PROJECT_DIR}/tool/notes.py\" --hook 2>/dev/null || python3 \"${CLAUDE_PROJECT_DIR}/tool/notes.py\" --hook 2>/dev/null || true",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"$HOME/Library/Application Support/TrackmaniaSkinChallenge/venv/bin/python\" \"${CLAUDE_PROJECT_DIR}/tool/guard.py\" turn 2>/dev/null || \"${LOCALAPPDATA}/TrackmaniaSkinChallenge/venv/Scripts/python.exe\" \"${CLAUDE_PROJECT_DIR}/tool/guard.py\" turn 2>/dev/null || python3 \"${CLAUDE_PROJECT_DIR}/tool/guard.py\" turn 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Library/Application Support/TrackmaniaSkinChallenge/venv/bin/python\" \"${CLAUDE_PROJECT_DIR}/tool/guard.py\" folder 2>/dev/null || \"${LOCALAPPDATA}/TrackmaniaSkinChallenge/venv/Scripts/python.exe\" \"${CLAUDE_PROJECT_DIR}/tool/guard.py\" folder 2>/dev/null || python3 \"${CLAUDE_PROJECT_DIR}/tool/guard.py\" folder 2>/dev/null || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Library/Application Support/TrackmaniaSkinChallenge/venv/bin/python\" \"${CLAUDE_PROJECT_DIR}/tool/guard.py\" agent 2>/dev/null || \"${LOCALAPPDATA}/TrackmaniaSkinChallenge/venv/Scripts/python.exe\" \"${CLAUDE_PROJECT_DIR}/tool/guard.py\" agent 2>/dev/null || python3 \"${CLAUDE_PROJECT_DIR}/tool/guard.py\" agent 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Library/Application Support/TrackmaniaSkinChallenge/venv/bin/python\" \"${CLAUDE_PROJECT_DIR}/tool/guard.py\" stop 2>/dev/null || \"${LOCALAPPDATA}/TrackmaniaSkinChallenge/venv/Scripts/python.exe\" \"${CLAUDE_PROJECT_DIR}/tool/guard.py\" stop 2>/dev/null || python3 \"${CLAUDE_PROJECT_DIR}/tool/guard.py\" stop 2>/dev/null || true",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
